rules_version = '2';

// Regras do Firestore da Atmavox: cada pessoa só lê e escreve os próprios dados.
// Cole este conteúdo em Firebase Console > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/journeys/{journeyId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.version == 1
        && request.resource.size() < 900 * 1024;
    }

    // Versão publicada de cada jornada (modo Andreía): qualquer pessoa lê, sem login.
    // A gravação entra com o papel de admin (Fase 4, passo 3).
    match /published/{journeyId} {
      allow read: if true;
      allow write: if false;
    }

    // Todo o resto é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
