rules_version = '2';

// Regras do Firestore da Atmavox: cada pessoa só lê e escreve os próprios dados.
// Cole este conteúdo em Firebase Console > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/journeys/{journeyId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.version == 1
        && request.resource.size() < 900 * 1024;
    }

    // Admin = existe o documento admins/{uid}, criado à mão no console (sem custo; custom claims
    // exigiriam Cloud Functions, plano pago). Ninguém se torna admin pelo site.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Acesso vale se o documento existe e não venceu (expiresAt nulo = para sempre). ADR-020.
    function hasAccess(productId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/access/$(productId);
      return request.auth != null
        && exists(path)
        && (get(path).data.expiresAt == null
            || get(path).data.expiresAt > request.time.toMillis());
    }

    // Catálogo (ADR-019): o que a vitrine e os hubs mostram, sem conteúdo. Qualquer pessoa lê.
    match /catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size() < 1000 * 1024;
    }

    // Conteúdo de cada produto (ADR-020). Grátis: qualquer pessoa lê. Pago: só quem tem acesso válido
    // (ou a admin). Documentos antigos sem `free` contam como grátis (a jornada de 21 dias).
    // Só leitura de um documento por vez: ninguém lista o conteúdo de todos.
    match /published/{productId} {
      allow get: if resource.data.get('free', true) == true || isAdmin() || hasAccess(productId);
      allow list: if false;
      allow write: if isAdmin() && request.resource.size() < 1000 * 1024;
    }

    // Acessos de cada pessoa: ela só lê os próprios. Quem grava é a admin (liberação manual) ou o
    // servidor do pagamento, com credencial de serviço (que não passa por estas regras).
    // Perfil mínimo (e-mail e nome), gravado pela própria pessoa ao entrar: é como a Andreía acha
    // alguém para liberar um acesso à mão. A pessoa lê o próprio; a admin lê e busca todos.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'lastSeenAt'])
        && request.resource.size() < 2 * 1024;
    }

    // Anamnese da ativação individual (ADR-029): só a própria pessoa grava; ela e a Andreía leem.
    match /users/{uid}/anamnesis/{doc} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size() < 100 * 1024;
    }

    // Pedidos da ativação individual (ADR-029). A pessoa cria como "Aguardando pagamento" e só pode
    // avisar que mandou a mensagem (Paga → Solicitada). Pagamento: servidor (credencial de serviço).
    // O resto (aprovar, realizar, cancelar): a Andreía.
    match /users/{uid}/sessions/{orderId} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'wait'
        && request.resource.data.keys().hasOnly(['status', 'content', 'createdAt'])
        && request.resource.size() < 50 * 1024;
      allow update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == uid
          && resource.data.status == 'paid'
          && request.resource.data.status == 'req'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requestedAt']))
        // Confirmar o horário que a Andreía aprovou: o mesmo horário, dentro das 24 h da reserva.
        || (request.auth != null
          && request.auth.uid == uid
          && resource.data.status in ['paid', 'req']
          && request.resource.data.status == 'sched'
          && request.resource.data.scheduled == resource.data.proposed
          && request.time.toMillis() < resource.data.proposedAt + 86400000
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'scheduled', 'scheduledAt']));
      allow delete: if isAdmin();
    }

    // A admin lista os pedidos de todo mundo (consulta em grupo, tela Pedidos do Modo Andreía).
    match /{path=**}/sessions/{orderId} {
      allow read: if isAdmin();
    }

    // A admin lista os acessos de todo mundo (consulta em grupo, tela Acessos do Modo Andreía).
    match /{path=**}/access/{productId} {
      allow read: if isAdmin();
    }

    match /users/{uid}/access/{productId} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Rascunhos e histórico de versões: só a admin.
    match /drafts/{journeyId}/{document=**} {
      allow read, write: if isAdmin();
    }

    // Imagens dos blocos (WebP pequeno, ADR-014): qualquer pessoa vê, só a admin envia.
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size() < 1000 * 1024;
    }

    // Todo o resto é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
