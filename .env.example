# Copie para .env.local (que não vai para o git) e preencha com a configuração do app web do Firebase.
# Firebase Console > Configurações do projeto > Seus apps > App da Web > Configuração do SDK.
# Sem estes valores o site funciona normalmente e o botão "Entrar" não aparece.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=atmavox-b72a4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=atmavox-b72a4
VITE_FIREBASE_APP_ID=
